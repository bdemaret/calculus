{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "pnpm --filter @calculus/db generate",
    "watchPatterns": ["apps/game-server/**", "packages/**", "package.json", "pnpm-lock.yaml", "railway.json", ".nvmrc"]
  },
  "deploy": {
    "preDeployCommand": ["pnpm --filter @calculus/db migrate:deploy"],
    "startCommand": "pnpm --filter @calculus/game-server start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "drainingSeconds": 20
  }
}
