# Copier ce fichier en `.env` à la racine du projet, puis remplir les valeurs.

# Base de données (celle de docker-compose en local ; celle de Neon en production)
DATABASE_URL="postgresql://calculus:calculus@127.0.0.1:5433/calculus"

# Authentification (Better Auth). Générer un secret : `openssl rand -base64 32`
# En production, le site et le serveur de jeu refusent de démarrer avec ces valeurs d'exemple ou un secret de moins de 32 caractères.
BETTER_AUTH_SECRET="remplace-moi-par-une-longue-chaine-aleatoire"
BETTER_AUTH_URL="http://localhost:3000"

# Secret partagé entre le site et le serveur de jeu (jetons de connexion aux lobbies)
GAME_TOKEN_SECRET="remplace-moi-aussi-par-une-autre-chaine-aleatoire"

# Adresse du serveur de jeu, vue depuis le navigateur
NEXT_PUBLIC_GAME_SERVER_URL="ws://localhost:2567"
# Port du serveur de jeu (en local) et origine autorisée du site
GAME_SERVER_PORT=2567
WEB_ORIGIN="http://localhost:3000"

# E-mails (mot de passe oublié). Sans clé, les e-mails s'affichent dans le terminal.
RESEND_API_KEY=""
EMAIL_FROM="Calculus <onboarding@resend.dev>"

# Mentions légales : nom de l'éditeur (vide = particulier anonyme, identité confiée à l'hébergeur) et e-mail de contact
LEGAL_PUBLISHER=""
LEGAL_CONTACT_EMAIL=""

# Panel administrateur (/admin) : ids des comptes administrateurs, séparés par des virgules.
# Jamais d'e-mail (ils ne sont pas vérifiés). Trouver l'id : `pnpm db:studio`, table `user`, ou en SQL
# SELECT id FROM "user" WHERE email = 'moi@exemple.fr';
ADMIN_USER_IDS=""

# Réservé aux tests e2e (déjà réglé dans apps/e2e/env.ts) : ne jamais activer en production.
# AUTH_RATE_LIMIT_DISABLED="1"
