{
  "name": "calculus",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.12 <27"
  },
  "scripts": {
    "lancer": "node scripts/lancer.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "e2e": "pnpm --filter @calculus/e2e e2e",
    "e2e:ui": "pnpm --filter @calculus/e2e e2e:ui",
    "typecheck": "turbo run typecheck",
    "db:up": "docker compose up -d db",
    "db:migrate": "pnpm --filter @calculus/db migrate",
    "db:studio": "pnpm --filter @calculus/db studio"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  }
}
