{
  "name": "@calculus/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev -p 3000",
    "build": "dotenv -e ../../.env -- next build",
    "start": "dotenv -e ../../.env -- next start -p ${PORT:-3000}",
    "start:combined": "NODE_ENV=production dotenv -e ../../.env -- tsx server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@calculus/db": "workspace:*",
    "@calculus/game-core": "workspace:*",
    "@calculus/game-server": "workspace:*",
    "better-auth": "^1.3.0",
    "canvas-confetti": "^1.9.3",
    "colyseus.js": "^0.16.0",
    "jose": "^6.0.0",
    "motion": "^12.23.0",
    "next": "^15.5.0",
    "next-intl": "^4.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.2.0",
    "resend": "^6.0.0",
    "server-only": "^0.0.1",
    "tsx": "^4.20.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "dotenv-cli": "^8.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  }
}
