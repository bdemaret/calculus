{
  "name": "@calculus/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./feedback": "./src/feedback.ts",
    "./guild": "./src/guild.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "seed:leaderboard": "dotenv -e ../../.env -- tsx scripts/seed-leaderboard.ts",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@calculus/game-core": "workspace:*",
    "@prisma/client": "^6.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.16.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
