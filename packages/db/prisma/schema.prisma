// Schéma de la base de données Calculus.
// Après une modification : `pnpm db:migrate` (crée une migration et met à jour le client).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ---------- Comptes (tables gérées par Better Auth) ---------- */

model User {
  id            String    @id
  /// Pseudo affiché en jeu
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  /// Saisie des réponses à la voix (reconnaissance vocale du navigateur)
  voiceInput    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  stats         UserStats?
  ratings       Rating[]
  gamesCreated  Game[]       @relation("GameHost")
  gamePlayers   GamePlayer[]
  friendsSent     Friendship[] @relation("FriendRequester")
  friendsReceived Friendship[] @relation("FriendAddressee")
  invitesSent     GameInvite[] @relation("InviteFrom")
  invitesReceived GameInvite[] @relation("InviteTo")
  feedbacks       Feedback[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Mot de passe chiffré (jamais en clair)
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

/// Compteurs du rate limit de Better Auth (connexion, inscription, mot de passe oublié…), partagés entre instances.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

/* ---------- Parties ---------- */

model Game {
  id          String       @id @default(cuid())
  /// Code du lobby (vide en solo)
  code        String?
  solo        Boolean      @default(false)
  hostId      String?
  host        User?        @relation("GameHost", fields: [hostId], references: [id], onDelete: SetNull)
  /// Paramètres complets (difficulté, mode, opérations…) au format JSON
  settings    Json
  mode        String
  difficulty  Int
  turnStyle   String
  seed        String
  rounds      Int
  startedAt   DateTime
  endedAt     DateTime
  players     GamePlayer[]
  questions   Question[]

  @@index([endedAt])
  @@map("game")
}

model GamePlayer {
  id           String   @id @default(cuid())
  gameId       String
  game         Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  /// Null pour un invité
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Identifiant utilisé pendant la partie (id du compte ou id invité)
  playerKey    String
  displayName  String
  rank         Int
  score        Int
  alive        Boolean
  eliminatedAt Int?
  answered     Int
  correct      Int
  correctTimeMs Int
  bestStreak   Int
  /// Elo avant la partie (null si la partie n'est pas classée : solo, invité, moins de deux comptes)
  ratingBefore Int?
  /// Variation d'Elo due à cette partie
  ratingDelta  Int?
  /// Parties classées jouées dans ce mode et cette difficulté, celle-ci comprise (≤ 5 : placement, Elo caché)
  ratingGames  Int?
  answers      Answer[]

  @@unique([gameId, playerKey])
  @@index([userId])
  @@map("game_player")
}

model Question {
  id         String   @id @default(cuid())
  gameId     String
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  /// Ordre dans la partie (0, 1, 2…)
  position   Int
  text       String
  answer     Int
  /// Opérations présentes : add, sub, mul, div, paren
  tags       String[]
  difficulty Int
  timeLimitMs Int
  activePlayerKey String?
  answers    Answer[]

  @@unique([gameId, position])
  @@map("question")
}

model Answer {
  id         String     @id @default(cuid())
  questionId String
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  playerId   String
  player     GamePlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  /// Null si le temps s'est écoulé
  value      Int?
  correct    Boolean
  timeMs     Int

  @@index([playerId])
  @@map("answer")
}

/* ---------- Amis ---------- */

enum FriendshipStatus {
  pending
  accepted
}

/// Une ligne par paire de joueurs : demande en attente, puis amitié acceptée (dans les deux sens).
model Friendship {
  id          String           @id @default(cuid())
  /// Celui qui a envoyé la demande
  requesterId String
  requester   User             @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  /// Celui qui doit l'accepter
  addresseeId String
  addressee   User             @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(pending)
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@map("friendship")
}

/// Invitation à rejoindre un lobby, affichée à l'ami connecté jusqu'à expiration.
model GameInvite {
  id        String   @id @default(cuid())
  fromId    String
  from      User     @relation("InviteFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        User     @relation("InviteTo", fields: [toId], references: [id], onDelete: Cascade)
  /// Code du lobby à rejoindre
  code      String
  createdAt DateTime @default(now())
  expiresAt DateTime

  /// Une seule invitation en cours par paire : une nouvelle remplace l'ancienne.
  @@unique([fromId, toId])
  @@index([toId, expiresAt])
  @@map("game_invite")
}

/// Elo d'un joueur, propre à chaque mode et à chaque difficulté (1000 au départ, caché pendant les 5 parties de placement).
model Rating {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode       String
  difficulty Int
  rating     Int
  /// Parties classées jouées dans ce mode et cette difficulté
  games      Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@id([userId, mode, difficulty])
  @@index([mode, difficulty, rating])
  @@map("rating")
}

/// Agrégats recalculés à chaque fin de partie, pour un dashboard rapide.
model UserStats {
  userId            String   @id
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gamesPlayed       Int      @default(0)
  onlineGames       Int      @default(0)
  soloGames         Int      @default(0)
  wins              Int      @default(0)
  answered          Int      @default(0)
  correct           Int      @default(0)
  totalCorrectTimeMs BigInt  @default(0)
  bestStreak        Int      @default(0)
  bestSurvival      Int      @default(0)
  updatedAt         DateTime @updatedAt

  @@map("user_stats")
}

/* ---------- Retours des joueurs ---------- */

enum FeedbackKind {
  bug
  idea
  other
}

/// Retour envoyé depuis la page « Faire un retour » (connecté ou invité), lu dans le panel administrateur.
model Feedback {
  id        String       @id @default(cuid())
  /// Null pour un invité, ou si le compte a été supprimé
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind      FeedbackKind
  message   String
  /// E-mail laissé par un invité pour être recontacté (facultatif)
  contact   String?
  /// Page d'où vient le retour (chemin seulement) et langue du site
  page      String?
  locale    String
  /// Traité par un administrateur
  resolved  Boolean      @default(false)
  createdAt DateTime     @default(now())

  @@index([resolved, createdAt])
  @@index([userId, createdAt])
  @@map("feedback")
}
