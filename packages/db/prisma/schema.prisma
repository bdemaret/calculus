// Schéma de la base de données Calculus.
// Après une modification : `pnpm db:migrate` (crée une migration et met à jour le client).

generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL : connexion du site et du serveur de jeu.
// DIRECT_URL : connexion des migrations. Même valeur que DATABASE_URL, sauf derrière un pooler de connexions
// (PgBouncer, Neon « -pooler »), qui ne tient pas leurs verrous : DIRECT_URL vise alors la base sans pooler.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/* ---------- Comptes (tables gérées par Better Auth) ---------- */

model User {
  id            String    @id
  /// Pseudo affiché en jeu
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  /// Adresse de la photo de profil (`/api/avatar/<id>?v=<version>`), null sans photo
  image         String?
  /// Saisie des réponses à la voix (reconnaissance vocale du navigateur)
  voiceInput    Boolean   @default(false)
  /// Affichage des divisions : "standard" (12 ÷ 4) ou "fraction" (barre de fraction)
  divisionDisplay String  @default("standard")
  /// Conseils de technique de calcul dans le rapport de fin de partie
  showTips      Boolean   @default(true)
  /// Titre choisi, affiché sous le pseudo. Hors de `additionalFields` : le client ne doit pas pouvoir l'écrire
  titleId       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  stats         UserStats?
  ratings       Rating[]
  gamesCreated  Game[]       @relation("GameHost")
  gamePlayers   GamePlayer[]
  friendsSent     Friendship[] @relation("FriendRequester")
  friendsReceived Friendship[] @relation("FriendAddressee")
  invitesSent     GameInvite[] @relation("InviteFrom")
  invitesReceived GameInvite[] @relation("InviteTo")
  feedbacks       Feedback[]
  soloPlays       SoloPlay[]
  avatar          Avatar?
  guildMember     GuildMember?
  guildInvitesReceived GuildInvite[] @relation("GuildInviteTo")
  guildInvitesSent     GuildInvite[] @relation("GuildInviteFrom")
  achievements    UserAchievement[]
  titles          UserTitle[]
  counters        UserCounter[]
  dailyRuns       DailyRun[]
  dungeonRuns     DungeonRunPlayer[]

  @@map("user")
}

/// Photo de profil, recadrée et réduite par le navigateur avant l'envoi
model Avatar {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Octets de l'image (PNG, JPEG ou WebP, vérifiés à la réception)
  data      Bytes
  mime      String
  updatedAt DateTime @updatedAt

  @@map("avatar")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Mot de passe chiffré (jamais en clair)
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

/// Compteurs du rate limit de Better Auth (connexion, inscription, mot de passe oublié…), partagés entre instances.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

/* ---------- Parties ---------- */

model Game {
  id          String       @id @default(cuid())
  /// Code du lobby (vide en solo)
  code        String?
  solo        Boolean      @default(false)
  hostId      String?
  host        User?        @relation("GameHost", fields: [hostId], references: [id], onDelete: SetNull)
  /// Paramètres complets (jeu, difficulté, mode, opérations…) au format JSON
  settings    Json
  /// Jeu (ce qu'on résout : standard, …) ; les parties d'avant les jeux sont en « standard »
  game        String       @default("standard")
  mode        String
  difficulty  Int
  turnStyle   String
  seed        String
  rounds      Int
  startedAt   DateTime
  endedAt     DateTime
  players     GamePlayer[]
  questions   Question[]
  soloPlay    SoloPlay?
  achievements UserAchievement[]

  @@index([endedAt])
  @@index([game, mode, difficulty])
  @@map("game")
}

model GamePlayer {
  id           String   @id @default(cuid())
  gameId       String
  game         Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  /// Null pour un invité
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Identifiant utilisé pendant la partie (id du compte ou id invité)
  playerKey    String
  displayName  String
  rank         Int
  score        Int
  alive        Boolean
  eliminatedAt Int?
  answered     Int
  correct      Int
  correctTimeMs Int
  bestStreak   Int
  /// Elo avant la partie (null si la partie n'est pas classée : solo, invité, moins de deux comptes)
  ratingBefore Int?
  /// Variation d'Elo due à cette partie
  ratingDelta  Int?
  /// Parties classées jouées dans ce jeu, ce mode et cette difficulté, celle-ci comprise (≤ 5 : placement, Elo caché)
  ratingGames  Int?
  answers      Answer[]

  @@unique([gameId, playerKey])
  @@index([userId])
  @@map("game_player")
}

model Question {
  id         String   @id @default(cuid())
  gameId     String
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  /// Ordre dans la partie (0, 1, 2…)
  position   Int
  text       String
  answer     Int
  /// Solution de référence lisible (null pour les parties d'avant les jeux : la réponse)
  solution   String?
  /// Données propres au jeu (plaques, trou…), sans la solution ; null pour les parties d'avant les jeux
  puzzle     Json?
  /// Opérations présentes : add, sub, mul, div, paren
  tags       String[]
  difficulty Int
  timeLimitMs Int
  activePlayerKey String?
  /// Joueur à qui ce calcul était destiné, quand chacun a le sien (la bombe) ; vide sinon
  forPlayerKey    String @default("")
  /// Joueur qui a construit ce calcul (la bombe), sinon null
  authorPlayerKey String?
  answers    Answer[]

  @@unique([gameId, position, forPlayerKey])
  @@map("question")
}

model Answer {
  id         String     @id @default(cuid())
  questionId String
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  playerId   String
  player     GamePlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  /// Nombre saisi ; null si le temps s'est écoulé ou si la réponse n'est pas un nombre
  value      Int?
  /// Expression ou opérateur saisi, quand la réponse n'est pas un nombre
  text       String?
  correct    Boolean
  timeMs     Int

  @@index([playerId])
  @@map("answer")
}

/* ---------- Amis ---------- */

enum FriendshipStatus {
  pending
  accepted
}

/// Une ligne par paire de joueurs : demande en attente, puis amitié acceptée (dans les deux sens).
model Friendship {
  id          String           @id @default(cuid())
  /// Celui qui a envoyé la demande
  requesterId String
  requester   User             @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  /// Celui qui doit l'accepter
  addresseeId String
  addressee   User             @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(pending)
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@map("friendship")
}

/// Invitation à rejoindre un lobby, affichée à l'ami connecté jusqu'à expiration.
model GameInvite {
  id        String   @id @default(cuid())
  fromId    String
  from      User     @relation("InviteFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        User     @relation("InviteTo", fields: [toId], references: [id], onDelete: Cascade)
  /// Code du lobby à rejoindre
  code      String
  /// Guilde dont c'est le lobby (invitation envoyée à tous ses membres), null pour une invitation entre amis
  guildId   String?
  guild     Guild?   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  /// Type de salle : `game` (lobby classique) ou `dungeon` (donjons), pour ouvrir la bonne page
  kind      String   @default("game")
  createdAt DateTime @default(now())
  expiresAt DateTime

  /// Une invitation par lobby et par paire : inviter de nouveau au même lobby la renouvelle.
  @@unique([fromId, toId, code])
  @@index([toId, expiresAt])
  @@index([code])
  @@map("game_invite")
}

/* ---------- Guildes ---------- */

enum GuildRole {
  leader
  member
}

/// Regroupement de joueurs (pas forcément amis), 50 au plus, mené par un chef. Un joueur est dans une guilde au plus.
model Guild {
  id          String        @id @default(cuid())
  name        String
  /// Nom en minuscules : deux guildes ne peuvent pas porter le même nom, quelle que soit la casse
  nameKey     String        @unique
  /// Adresse du blason (`/api/guild/crest/<id>?v=<version>`), null sans blason
  crest       String?
  createdAt   DateTime      @default(now())
  members     GuildMember[]
  invites     GuildInvite[]
  crestImage  GuildCrest?
  gameInvites GameInvite[]

  @@map("guild")
}

/// Appartenance d'un joueur à une guilde (une ligne par joueur : jamais deux guildes à la fois).
model GuildMember {
  userId     String    @id
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guildId    String
  guild      Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  role       GuildRole @default(member)
  joinedAt   DateTime  @default(now())
  /// Dernière activité sur le site (mise à jour toutes les 15 s par le site ouvert), pour « en ligne / hors ligne »
  lastSeenAt DateTime?

  @@index([guildId])
  @@map("guild_member")
}

/// Invitation à entrer dans une guilde, envoyée par n'importe quel membre, jusqu'à acceptation ou refus.
model GuildInvite {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  toId      String
  to        User     @relation("GuildInviteTo", fields: [toId], references: [id], onDelete: Cascade)
  /// Membre qui a invité (null si son compte a été supprimé)
  fromId    String?
  from      User?    @relation("GuildInviteFrom", fields: [fromId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([guildId, toId])
  @@index([toId])
  @@map("guild_invite")
}

/// Blason d'une guilde, recadré et réduit par le navigateur avant l'envoi (comme les photos de profil)
model GuildCrest {
  guildId   String   @id
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  data      Bytes
  mime      String
  updatedAt DateTime @updatedAt

  @@map("guild_crest")
}

/// Elo d'un joueur, propre à chaque jeu, chaque mode et chaque difficulté (1000 au départ, caché pendant les 5 parties de placement).
model Rating {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game       String   @default("standard")
  mode       String
  difficulty Int
  rating     Int
  /// Parties classées jouées dans ce jeu, ce mode et cette difficulté
  games      Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@id([userId, game, mode, difficulty])
  @@index([game, mode, difficulty, rating])
  @@map("rating")
}

/// Agrégats recalculés à chaque fin de partie, pour un dashboard rapide.
model UserStats {
  userId            String   @id
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gamesPlayed       Int      @default(0)
  onlineGames       Int      @default(0)
  soloGames         Int      @default(0)
  wins              Int      @default(0)
  answered          Int      @default(0)
  correct           Int      @default(0)
  totalCorrectTimeMs BigInt  @default(0)
  bestStreak        Int      @default(0)
  bestSurvival      Int      @default(0)
  updatedAt         DateTime @updatedAt

  @@map("user_stats")
}

/* ---------- Succès et titres ---------- */

/// Succès obtenu. Le catalogue est dans game-core : `achievementId` n'est pas une clé étrangère.
model UserAchievement {
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  unlockedAt    DateTime  @default(now())
  /// Partie qui l'a débloqué (null : succès social ou partie supprimée)
  gameId        String?
  game          Game?     @relation(fields: [gameId], references: [id], onDelete: SetNull)
  /// Null tant que le joueur ne l'a pas vu
  seenAt        DateTime?

  @@id([userId, achievementId])
  @@index([achievementId])
  @@index([gameId])
  @@map("user_achievement")
}

/// Titre possédé, quelle que soit la façon dont il a été obtenu.
model UserTitle {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleId    String
  /// D'où vient le titre : `achievement` pour l'instant
  source     String
  /// Ce qui l'a donné : l'id du succès
  sourceRef  String?
  unlockedAt DateTime @default(now())

  @@id([userId, titleId])
  @@map("user_title")
}

/// Compteur cumulatif d'un joueur (`games`, `wins:bomb`…), incrémenté par `saveGame`.
model UserCounter {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  key    String
  value  Int    @default(0)

  @@id([userId, key])
  @@map("user_counter")
}

/* ---------- Retours des joueurs ---------- */

enum FeedbackKind {
  bug
  idea
  other
}

/// Retour envoyé depuis la page « Faire un retour » (connecté ou invité), lu dans le panel administrateur.
model Feedback {
  id        String       @id @default(cuid())
  /// Null pour un invité, ou si le compte a été supprimé
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind      FeedbackKind
  message   String
  /// E-mail laissé par un invité pour être recontacté (facultatif)
  contact   String?
  /// Page d'où vient le retour (chemin seulement) et langue du site
  page      String?
  locale    String
  /// Traité par un administrateur
  resolved  Boolean      @default(false)
  createdAt DateTime     @default(now())

  @@index([resolved, createdAt])
  @@index([userId, createdAt])
  @@map("feedback")
}

/// Partie solo commencée (invités compris), signalée par le navigateur : suivi d'activité du panel administrateur.
/// Indicatif seulement (manches et bonnes réponses viennent du client), jamais utilisé pour un classement.
/// Lignes de plus de `SOLO_PLAY_RETENTION_MS` supprimées à chaque nouvelle partie.
model SoloPlay {
  id         String    @id @default(cuid())
  /// Null pour un invité, ou si le compte a été supprimé
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  game       String
  mode       String
  difficulty Int
  startedAt  DateTime  @default(now())
  /// Dernier signal du navigateur (début, battement régulier ou fin)
  lastSeenAt DateTime  @default(now())
  /// Null tant que la partie n'est pas close ; sans signal récent, elle est considérée abandonnée
  endedAt    DateTime?
  /// `finished` (allée au bout) ou `quit` (page quittée en cours de partie)
  outcome    String?
  rounds     Int       @default(0)
  correct    Int       @default(0)
  /// Partie enregistrée par `/api/solo-results` (joueur connecté seulement)
  gameId     String?   @unique
  savedGame  Game?     @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@index([startedAt])
  @@index([endedAt, lastSeenAt])
  @@map("solo_play")
}

/* ---------- Calcul du jour ---------- */

/// Graine d'un jour, tirée côté serveur à la première demande : le même calcul pour tous, imprévisible avant le jour J.
model DailyChallenge {
  /// Jour à Paris, « 2026-11-01 »
  date      String     @id
  seed      String
  /// Renseigné quand le gagnant du jour a été désigné : plus aucun score ne peut entrer au classement
  settledAt DateTime?
  runs      DailyRun[]

  @@index([settledAt])
  @@map("daily_challenge")
}

/// Essai d'un joueur (un seul par jour pour un compte). Le serveur tient le chrono : aucun temps ne vient du navigateur.
model DailyRun {
  id          String         @id @default(cuid())
  date        String
  challenge   DailyChallenge @relation(fields: [date], references: [date], onDelete: Cascade)
  /// Secret gardé par le navigateur : c'est lui qui désigne l'essai d'un invité, et permet de le rattacher à un compte
  token       String         @unique
  /// Null pour un invité (hors classement tant qu'il n'a pas de compte)
  userId      String?
  user        User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Calcul en cours, ou prochain calcul à poser
  index       Int            @default(0)
  /// Heure serveur à laquelle le calcul en cours a été envoyé ; null entre deux calculs
  questionAt  DateTime?
  correct     Int            @default(0)
  /// Temps total de calcul, en ms : les corrections et pauses entre deux calculs n'y entrent pas
  totalTimeMs Int            @default(0)
  /// Réponses données : tableau de `{ value, correct, timeMs }`, value null si le temps s'est écoulé
  answers     Json           @default("[]")
  startedAt   DateTime
  finishedAt  DateTime?
  /// Meilleur score du jour, posé à la clôture : compteur du succès `daily-champion`
  won         Boolean        @default(false)

  @@unique([date, userId])
  @@index([date, finishedAt, correct, totalTimeMs])
  @@index([userId, won])
  @@map("daily_run")
}

/* ---------- Donjons (coopération) ---------- */

/// Une expédition en donjon : hors parties, Elo et statistiques (`saveGame`)
model DungeonRun {
  id              String   @id @default(cuid())
  /// Code du lobby
  code            String
  seed            String
  difficulty      Int
  playerCount     Int
  /// `won` | `lost`
  outcome         String
  /// `no-enemy-defeated` | `team-down` | `boss-timeout`, null pour une victoire
  lossReason      String?
  /// Manches jouées (1 à 5, la 5e est le boss)
  roundsPlayed    Int
  score           Int
  enemiesDefeated Int
  /// Sceaux brisés (chacun affaiblit le boss), 0 pour les expéditions de la première version
  sealsBroken     Int        @default(0)
  /// PV du boss au départ et à la fin, null si l'équipe ne l'a pas atteint
  bossMaxHp       Int?
  bossHp          Int?
  startedAt       DateTime
  endedAt         DateTime
  players         DungeonRunPlayer[]

  @@index([endedAt])
  @@map("dungeon_run")
}

/// Part d'un joueur dans une expédition
model DungeonRunPlayer {
  id              String     @id @default(cuid())
  runId           String
  run             DungeonRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// Null une fois le compte supprimé (les donjons sont réservés aux comptes)
  userId          String?
  user            User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Identifiant utilisé pendant l'expédition (id du compte)
  playerKey       String
  displayName     String
  /// Ordre d'arrivée dans le lobby (couloir de départ)
  position        Int
  lives           Int
  livesLost       Int
  enemiesDefeated Int
  points          Int
  bossDamage      Int
  heartsGiven     Int
  heartsReceived  Int
  /// Objets de butin trouvés (coffres, mimiques, ennemis redoutables)
  itemsFound      Int        @default(0)
  correct         Int
  answered        Int
  avgTimeMs       Int?
  /// Parti avant la fin : ne compte pas dans les expéditions réussies (succès)
  left            Boolean    @default(false)

  @@unique([runId, playerKey])
  @@index([userId])
  @@map("dungeon_run_player")
}
